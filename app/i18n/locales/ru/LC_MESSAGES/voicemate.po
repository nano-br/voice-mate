msgstr "[VoiceMate] Горячая клавиша {hotkey}: → {label}"

#: app/main.py:238
#, python-brace-format
msgid "[VoiceMate] HTTP API on http://127.0.0.1:{port}."
msgstr "[VoiceMate] HTTP API на http://127.0.0.1:{port}."

#: app/main.py:239
#, python-brace-format
msgid "[VoiceMate] Max recording: {seconds}s"
msgstr "[VoiceMate] Максимальная длительность записи: {seconds} с"

#: app/main.py:241
msgid "[VoiceMate] Ctrl+C to exit.\n"
msgstr "[VoiceMate] Ctrl+C для выхода.\n"

#: app/main.py:254
#, python-brace-format
