msgstr "Ожидание нажатия {hotkey}"

#: app/companion/model.py:666 app/companion/ui/texts.py:135
#: app/companion/ui/texts.py:274
msgid "Ready"
msgstr "Готов к работе"

#: app/companion/model.py:669 app/companion/ui/texts.py:116
#, python-brace-format
msgid "Recording {elapsed}"
msgstr "Запись {elapsed}"

#: app/companion/model.py:671 app/companion/ui/texts.py:137
msgid "Transcribing..."
msgstr "Расшифровка..."

#: app/companion/model.py:673 app/companion/ui/texts.py:139
msgid "Claude is answering..."
msgstr "Claude отвечает..."

#: app/companion/model.py:675 app/companion/ui/texts.py:142
#, python-brace-format
msgid "Copied: {text}"
msgstr "Скопировано: {text}"

#: app/companion/model.py:681
msgid ""
"WSL needs a restart to recover the audio. Use Restart WSL now... in the "
"menu."
msgstr ""
"Чтобы вернуть звук, нужно перезапустить WSL. Выберите в меню "
"«Перезапустить WSL сейчас...»."

#: app/companion/model.py:719
msgid "No microphone is connected. Connect one and try again."
msgstr "Микрофон не подключён. Подключите его и повторите попытку."

#: app/companion/model.py:723
msgid ""
"The engine could not open the microphone. Allow desktop apps to use the "
"microphone in the Windows privacy settings, and close any app that holds "
"it exclusively."
msgstr ""
"Движку не удалось открыть микрофон. Разрешите классическим приложениям "
"доступ к микрофону в параметрах конфиденциальности Windows и закройте "
"приложения, которые используют его монопольно."

#: app/companion/model.py:726
msgid ""
"The engine could not open the microphone. Close any app that holds it "
"exclusively."
msgstr ""
"Движку не удалось открыть микрофон. Закройте приложения, которые "
"используют его монопольно."

#: app/companion/model.py:728
msgid ""
"The engine could not open the microphone: the audio server is not "
"responding."
msgstr "Движку не удалось открыть микрофон: аудиосервер не отвечает."

#: app/companion/model.py:731
msgid ""
"Windows has a microphone, but WSL cannot open it: its audio bridge is "
"stuck. Restarting WSL fixes it."
msgstr ""
"В Windows есть микрофон, но WSL не может его открыть: аудиомост завис. "
"Перезапуск WSL это исправит."

#: app/companion/model.py:733
msgid ""
"WSL cannot open the microphone. If one is connected, restarting WSL fixes"
" it."
msgstr ""
"WSL не может открыть микрофон. Если микрофон подключён, перезапуск WSL "
"это исправит."

#: app/companion/model.py:742
msgid "VoiceMate is starting"
msgstr "VoiceMate запускается"

#: app/companion/model.py:743
msgid "The engine is still loading. Try again in a moment."
msgstr "Движок ещё загружается. Повторите попытку через несколько секунд."

#: app/companion/model.py:750
msgid "The engine is not running. Use Restart engine in the menu."
msgstr "Движок не запущен. Выберите в меню «Перезапустить движок»."

#: app/companion/model.py:756 app/companion/model.py:763
msgid "VoiceMate stopped retrying"
msgstr "VoiceMate прекратил попытки"

#: app/companion/model.py:765
msgid ""
"Restarting WSL did not bring the audio back. Check the engine log, then "
"use Restart WSL... in the Engine menu."
msgstr ""
"Перезапуск WSL не вернул звук. Посмотрите журнал движка, затем выберите "
"«Перезапустить WSL...» в меню «Движок»."

#: app/companion/model.py:773
msgid "VoiceMate could not find the engine. Set the engine folder in Settings."
msgstr "VoiceMate не нашёл движок. Укажите папку движка в настройках."

#: app/companion/model.py:779
msgid "Could not start the engine"
msgstr "Не удалось запустить движок"

#: app/companion/model.py:780
msgid ""
"Starting the engine failed. VoiceMate will try again; the engine log has "
"the details."
msgstr ""
"Не удалось запустить движок. VoiceMate попробует снова; подробности в "
"журнале движка."

#: app/companion/model.py:786
msgid "Restarting WSL"
msgstr "Перезапуск WSL"

#: app/companion/model.py:787
msgid ""
"WSL lost its audio, so VoiceMate is restarting it. This takes a few "
"seconds."
msgstr ""
"WSL потерял звук, поэтому VoiceMate перезапускает его. Это займёт "
"несколько секунд."

#: app/companion/model.py:793 app/companion/model.py:800
msgid "WSL needs a restart"
msgstr "Нужно перезапустить WSL"

#: app/companion/model.py:794
msgid "WSL lost its audio. Choose Restart WSL now... in the VoiceMate menu."
msgstr "WSL потерял звук. Выберите «Перезапустить WSL сейчас...» в меню VoiceMate."

#: app/companion/model.py:802
#, python-brace-format
msgid ""
"WSL lost its audio, but restarting it also stops {distros}. Choose "
"Restart WSL now... in the VoiceMate menu when convenient."
msgstr ""
"WSL потерял звук, но его перезапуск остановит и {distros}. Выберите "
"«Перезапустить WSL сейчас...» в меню VoiceMate, когда будет удобно."

#: app/companion/model.py:811
msgid ""
"The engine is older than this app. Update it, then use Restart engine in "
"the menu."
msgstr ""
"Движок старше этого приложения. Обновите его, затем выберите в меню "
"«Перезапустить движок»."

#: app/companion/model.py:817
msgid "Engine run by systemd"
msgstr "Движок запущен через systemd"

#: app/companion/model.py:819
msgid ""
"A systemd service runs the engine, so VoiceMate attaches to it. To let "
"VoiceMate manage it, run `systemctl --user disable --now voicemate` in "
"WSL."
msgstr ""
"Движок запущен службой systemd, поэтому VoiceMate подключается к нему. "
"Чтобы VoiceMate управлял движком сам, выполните `systemctl --user disable"
" --now voicemate` в WSL."

#: app/companion/model.py:827
msgid "Engine access denied"
msgstr "Доступ к движку запрещён"

#: app/companion/model.py:829
msgid ""
"The engine refused VoiceMate's access token. VoiceMate reads "
"`~/.config/voicemate/api-token` again every 30 seconds; the engine log "
"has the details."
msgstr ""
"Движок отклонил токен доступа VoiceMate. VoiceMate перечитывает "
"`~/.config/voicemate/api-token` каждые 30 секунд; подробности в журнале "
"движка."

#: app/companion/model.py:837
msgid "Settings reset"
msgstr "Настройки сброшены"

#: app/companion/model.py:839
#, python-brace-format
msgid ""
"The settings file could not be read, so VoiceMate started with the "
"default settings. The old file was kept as {path}."
msgstr ""
"Не удалось прочитать файл настроек, поэтому VoiceMate запущен с "
"настройками по умолчанию. Старый файл сохранён как {path}."

#: app/companion/model.py:847
msgid "\"Not copied\" list reset"
msgstr "Список «Нескопированные» сброшен"

#: app/companion/model.py:849
#, python-brace-format
msgid ""
"The saved \"Not copied\" list could not be read, so it starts empty. The "
"old file, with the transcriptions it held, was kept as {path}."
msgstr ""
"Не удалось прочитать сохранённый список «Нескопированные», поэтому он "
"очищен. Старый файл с его расшифровками сохранён как {path}."

#: app/companion/model.py:857
msgid "Engine unreachable"
msgstr "Движок недоступен"

#: app/companion/model.py:858
msgid "The engine did not answer. VoiceMate keeps trying to reconnect."
msgstr "Движок не ответил. VoiceMate продолжает пытаться переподключиться."

#: app/companion/model.py:864
msgid "Engine busy"
msgstr "Движок занят"

#: app/companion/model.py:865
msgid "The engine did not answer in time. It may still act on this key press."
msgstr "Движок не ответил вовремя. Он ещё может отреагировать на это нажатие."

