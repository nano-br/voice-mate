#, python-brace-format
msgid "[VoiceMate] Daemon listening on http://127.0.0.1:{port} (POST /trigger)."
msgstr "[VoiceMate] Демон слушает http://127.0.0.1:{port} (POST /trigger)."

#: app/main.py:231
msgid ""
"[VoiceMate] Register the Windows-side hotkeys with scripts/windows"
"/voicemate-hotkeys.ahk (or .ps1)."
msgstr ""
"[VoiceMate] Зарегистрируйте горячие клавиши на стороне Windows с помощью "
"scripts/windows/voicemate-hotkeys.ahk (или .ps1)."

#: app/main.py:235
msgid "clipboard"
msgstr "буфер обмена"

#: app/main.py:235
msgid "Claude (multi-turn)"
msgstr "Claude (многоходовой диалог)"

#: app/main.py:236
#, python-brace-format
