msgstr "[VoiceMate] Не удалось закрыть обработчик: {exc}"

#: app/main.py:262
#, python-brace-format
msgid "[VoiceMate] Failed to close transcriber: {exc}"
msgstr "[VoiceMate] Не удалось закрыть модуль распознавания: {exc}"

#: app/main.py:296
msgid "[VoiceMate] Supervised: closing stdin shuts the engine down."
msgstr "[VoiceMate] Режим под управлением: закрытие stdin останавливает движок."

#: app/main.py:315 app/main.py:387
msgid ""
"\n"
"[VoiceMate] Shutting down."
msgstr ""
"\n"
"[VoiceMate] Завершение работы."

#: app/main.py:321
#, python-brace-format
msgid "[VoiceMate] ❌ The engine failed to start: {exc}"
msgstr "[VoiceMate] ❌ Не удалось запустить движок: {exc}"

#: app/main.py:374
#, python-brace-format
msgid "[VoiceMate] Failed to stop the listener: {exc}"
msgstr "[VoiceMate] Не удалось остановить слушатель ввода: {exc}"

#: app/cli/config_builder.py:125
msgid "[VoiceMate] ⚠ Claude flow requires input-method=keyboard. Disabling."
msgstr "[VoiceMate] ⚠ Режиму Claude нужен input-method=keyboard. Режим отключён."

#: app/cli/config_builder.py:144
msgid ""
"[VoiceMate] ⚠ --claude-no-system-prompt and --claude-system-prompt were "
"passed together; using --claude-no-system-prompt."
msgstr ""
"[VoiceMate] ⚠ Переданы одновременно --claude-no-system-prompt и --claude-"
"system-prompt; используется --claude-no-system-prompt."

#: app/cli/config_builder.py:257
#, python-brace-format
msgid "[VoiceMate] Auto-seed removed: {path}"
msgstr "[VoiceMate] Автообразец голоса удалён: {path}"

#: app/cli/config_builder.py:260
#, python-brace-format
msgid "[VoiceMate] ⚠ Failed to remove {path}: {exc}"
msgstr "[VoiceMate] ⚠ Не удалось удалить {path}: {exc}"

#: app/cli/wiring.py:71
msgid ""
"[VoiceMate]   Install the GPU mode from the companion or with `make stt-"
"install MODE=gpu`."
msgstr ""
"[VoiceMate]   Установите режим GPU в приложении или командой `make stt-"
"install MODE=gpu`."

#: app/cli/wiring.py:83
#, python-brace-format
msgid "[VoiceMate] ⚠ openai-whisper failed: {exc}"
msgstr "[VoiceMate] ⚠ Ошибка openai-whisper: {exc}"

#: app/cli/wiring.py:90
msgid ""
"[VoiceMate] ⚠ whisper.cpp not found (run `make configure`); trying "
"fallback."
msgstr ""
"[VoiceMate] ⚠ whisper.cpp не найден (выполните `make configure`); пробуем"
" резервный вариант."

#: app/cli/wiring.py:97
#, python-brace-format
msgid "[VoiceMate] ⚠ whisper.cpp failed; falling back: {exc}"
msgstr "[VoiceMate] ⚠ Ошибка whisper.cpp; переход на резервный вариант: {exc}"

#: app/cli/wiring.py:117
#, python-brace-format
msgid "[VoiceMate] ⚠ faster-whisper (CT2-ROCm) failed on the AMD GPU: {exc}"
msgstr "[VoiceMate] ⚠ faster-whisper (CT2-ROCm) не работает на GPU AMD: {exc}"

#: app/cli/wiring.py:120
msgid "[VoiceMate]   Disabling until the next `make configure`."
msgstr "[VoiceMate]   Отключён до следующего запуска `make configure`."

#: app/cli/wiring.py:127
#, python-brace-format
msgid "[VoiceMate] ⚠ Failed to persist ct2_rocm_ok: {persist_exc}"
msgstr "[VoiceMate] ⚠ Не удалось сохранить ct2_rocm_ok: {persist_exc}"

#: app/cli/wiring.py:168
msgid ""
"[VoiceMate] ⚠ No GPU backend available on AMD; using faster-whisper on "
"CPU."
msgstr ""
"[VoiceMate] ⚠ Для AMD нет доступного GPU-бэкенда; используется faster-"
"whisper на CPU."

#: app/cli/wiring.py:190
msgid "[VoiceMate] ⚠ GPU mode requested but no supported GPU was found."
msgstr "[VoiceMate] ⚠ Запрошен режим GPU, но совместимая видеокарта не найдена."

#: app/cli/wiring.py:223
#, python-brace-format
msgid "[VoiceMate] ⚠ TTS disabled: engine '{engine}' packages not installed."
msgstr "[VoiceMate] ⚠ TTS отключён: пакеты движка '{engine}' не установлены."

#: app/cli/wiring.py:227
#, python-brace-format
msgid ""
"[VoiceMate]   Install with: poetry install --extras {extra} (or run with "
"--no-tts)."
msgstr ""
"[VoiceMate]   Установите: poetry install --extras {extra} (или запустите "
"с --no-tts)."

#: app/cli/wiring.py:237
#, python-brace-format
msgid "[VoiceMate] ⚠ TTS disabled (failed to start engine '{engine}'): {exc}"
msgstr "[VoiceMate] ⚠ TTS отключён (не удалось запустить движок '{engine}'): {exc}"

#: app/cli/wiring.py:244
#, python-brace-format
msgid ""
"[VoiceMate]   Check `poetry install --extras {extra}`, GPU availability, "
"or run with `--no-tts`."
msgstr ""
"[VoiceMate]   Проверьте `poetry install --extras {extra}`, доступность "
"GPU или запустите с `--no-tts`."

#: app/cli/wiring.py:284
msgid "[VoiceMate] ⚠ Claude flow disabled: extra 'claude' not installed."
msgstr "[VoiceMate] ⚠ Режим Claude отключён: extra 'claude' не установлен."

#: app/cli/wiring.py:288
msgid "[VoiceMate]   Install with: poetry install --extras claude"
msgstr "[VoiceMate]   Установите: poetry install --extras claude"

#: app/cli/wiring.py:304
#, python-brace-format
msgid "[VoiceMate] ⚠ Failed to start Claude (run `claude login`): {exc}"
msgstr ""
"[VoiceMate] ⚠ Не удалось запустить Claude (выполните `claude login`): "
"{exc}"

#: app/cli/wiring.py:316
#, python-brace-format
msgid "[VoiceMate] ⚠ Unknown flow ignored: {kind}"
msgstr "[VoiceMate] ⚠ Неизвестный режим пропущен: {kind}"

#: app/cli/wiring.py:355
#, python-brace-format
msgid ""
"[VoiceMate] ⚠ --input-method mouse is only supported on Windows "
"(trigger={trigger}); using keyboard hotkeys."
msgstr ""
"[VoiceMate] ⚠ --input-method mouse поддерживается только в Windows "
"(trigger={trigger}); используются горячие клавиши."

#: app/companion/controller.py:629
msgid ""
"The settings file was written by a newer version of VoiceMate, so it is "
"read-only here."
msgstr ""
"Файл настроек записан более новой версией VoiceMate, поэтому здесь он "
"доступен только для чтения."

#: app/companion/controller.py:648
msgid "Could not save the settings file."
msgstr "Не удалось сохранить файл настроек."

#: app/companion/controller.py:676
#, python-brace-format
msgid "{hotkey} is already used by another app."
msgstr "{hotkey} уже используется другим приложением."

#: app/companion/controller.py:741
msgid "Could not change the start at login setting."
msgstr "Не удалось изменить параметр запуска при входе в систему."

#: app/companion/cues.py:80 app/companion/ui/texts.py:151
msgid "Recording started"
msgstr "Запись началась"

#: app/companion/cues.py:81 app/companion/ui/texts.py:152
msgid "Transcribing"
msgstr "Расшифровка"

#: app/companion/cues.py:82 app/companion/ui/texts.py:106
#: app/companion/ui/texts.py:153
msgid "Copied"
msgstr "Скопировано"

#: app/companion/cues.py:83 app/companion/ui/texts.py:154
msgid "Claude answered"
msgstr "Claude ответил"

#: app/companion/cues.py:84 app/companion/ui/texts.py:155
msgid "Warning"
msgstr "Предупреждение"

#: app/companion/cues.py:85 app/companion/ui/texts.py:156
msgid "Error"
msgstr "Ошибка"

#: app/companion/main.py:130
#, python-brace-format
msgid ""
"VoiceMate cannot find its data folder: {variable} is not set and the home"
" folder is unknown. Set {variable} or {home_variable} for your user and "
"start VoiceMate again."
msgstr ""
"VoiceMate не может найти папку данных: переменная {variable} не задана, а"
" домашняя папка неизвестна. Задайте {variable} или {home_variable} для "
"своего пользователя и запустите VoiceMate снова."

#: app/companion/main.py:193
msgid "Settings"
msgstr "Настройки"

#: app/companion/main.py:193 app/companion/ui/status_window.py:122
#: app/companion/ui/status_window.py:180 app/companion/ui/tray.py:112
msgid "Restart engine"
msgstr "Перезапустить движок"

#: app/companion/main.py:195 app/companion/ui/tray.py:114
msgid "Restart WSL..."
msgstr "Перезапустить WSL..."

#: app/companion/main.py:196 app/companion/ui/status_window.py:184
#: app/companion/ui/tray.py:122
msgid "Quit VoiceMate"
msgstr "Выйти из VoiceMate"

#: app/companion/model.py:611
msgid "Engine not responding"
msgstr "Движок не отвечает"

#: app/companion/model.py:611
msgid "No answer from the engine. VoiceMate restarts it if this continues."
msgstr "Нет ответа от движка. Если так продолжится, VoiceMate перезапустит его."

#: app/companion/model.py:613 app/companion/model.py:810
msgid "Engine is outdated"
msgstr "Движок устарел"

#: app/companion/model.py:613
msgid "The engine is older than this app. Update it, then use Restart engine."
msgstr ""
"Движок старше этого приложения. Обновите его, затем нажмите "
"«Перезапустить движок»."

#: app/companion/model.py:616 app/companion/model.py:916
#: app/companion/ui/texts.py:109
msgid "No microphone"
msgstr "Нет микрофона"

#: app/companion/model.py:616
msgid "Connect a microphone to record."
msgstr "Подключите микрофон, чтобы записывать."

#: app/companion/model.py:619 app/companion/model.py:903
#: app/companion/ui/demo_controller.py:351 app/companion/ui/texts.py:111
msgid "WSL audio stopped"
msgstr "Звук в WSL остановлен"

#: app/companion/model.py:619
msgid "WSL lost its audio bridge. Restarting WSL brings it back."
msgstr "WSL потерял аудиомост. Перезапуск WSL вернёт его."

#: app/companion/model.py:620 app/companion/model.py:909
msgid "Audio server is down"
msgstr "Аудиосервер не работает"

#: app/companion/model.py:620
msgid "The engine cannot reach the audio server."
msgstr "Движок не может подключиться к аудиосерверу."

#: app/companion/model.py:622 app/companion/model.py:626
#: app/companion/model.py:627 app/companion/model.py:889
msgid "Microphone unavailable"
msgstr "Микрофон недоступен"

#: app/companion/model.py:623
msgid ""
"Check the privacy settings for microphone access by desktop apps, and "
"close any app that holds the microphone."
msgstr ""
"Проверьте параметры конфиденциальности: доступ классических приложений к "
"микрофону должен быть разрешён. Закройте приложения, которые заняли "
"микрофон."

#: app/companion/model.py:626
msgid "WSL cannot open the microphone. Restarting WSL fixes it."
msgstr "WSL не может открыть микрофон. Перезапуск WSL это исправит."

#: app/companion/model.py:627
msgid "The engine cannot open the microphone."
msgstr "Движок не может открыть микрофон."

#: app/companion/model.py:632
msgid "The engine stopped unexpectedly."
msgstr "Движок неожиданно остановился."

#: app/companion/model.py:633
msgid "The engine stopped answering."
msgstr "Движок перестал отвечать."

#: app/companion/model.py:634
msgid "The engine took too long to start."
msgstr "Движок слишком долго запускался."

#: app/companion/model.py:635
msgid "Restarting WSL to recover the audio."
msgstr "Перезапуск WSL для восстановления звука."

#: app/companion/model.py:636
msgid "Restart requested."
msgstr "Запрошен перезапуск."

#: app/companion/model.py:637
msgid "Restarting WSL."
msgstr "Перезапуск WSL."

#: app/companion/model.py:638
msgid "The engine is restarting."
msgstr "Движок перезапускается."

#: app/companion/model.py:645 app/companion/model.py:772
msgid "Engine folder not found"
msgstr "Папка движка не найдена"

#: app/companion/model.py:645
msgid "Set the engine folder in Settings."
msgstr "Укажите папку движка в настройках."

#: app/companion/model.py:647 app/companion/model.py:650
msgid "Engine failed"
msgstr "Сбой движка"

#: app/companion/model.py:648
msgid ""
"Restarting WSL did not help. Check the engine log, then use Restart "
"WSL... in the Engine menu."
msgstr ""
"Перезапуск WSL не помог. Посмотрите журнал движка, затем выберите "
"«Перезапустить WSL...» в меню «Движок»."

#: app/companion/model.py:650 app/companion/model.py:757
msgid ""
"The engine failed too many times. Check the engine log, then use Restart "
"engine."
msgstr ""
"Движок слишком часто давал сбой. Посмотрите журнал движка, затем нажмите "
"«Перезапустить движок»."

#: app/companion/model.py:656 app/companion/model.py:749
#: app/companion/ui/texts.py:87
msgid "VoiceMate is stopped"
msgstr "VoiceMate остановлен"

#: app/companion/model.py:658 app/companion/ui/texts.py:89
msgid "Starting engine..."
msgstr "Запуск движка..."

#: app/companion/model.py:660
#, python-brace-format
msgid "Waiting for the engine on port {port}."
msgstr "Ожидание движка на порту {port}."

#: app/companion/model.py:662 app/companion/ui/texts.py:93
#, python-brace-format
msgid "Restarting (attempt {attempt})"
msgstr "Перезапуск (попытка {attempt})"

#: app/companion/model.py:666
#, python-brace-format
msgid "Listening for {hotkey}"
msgstr "Ожидание нажатия {hotkey}"

#: app/companion/model.py:666 app/companion/ui/texts.py:98
msgid "Ready"
msgstr "Готов к работе"

#: app/companion/model.py:669 app/companion/ui/texts.py:79
#, python-brace-format
msgid "Recording {elapsed}"
msgstr "Запись {elapsed}"

#: app/companion/model.py:671 app/companion/ui/texts.py:100
msgid "Transcribing..."
msgstr "Расшифровка..."

#: app/companion/model.py:673 app/companion/ui/texts.py:102
msgid "Claude is answering..."
msgstr "Claude отвечает..."

#: app/companion/model.py:675 app/companion/ui/texts.py:105
#, python-brace-format
msgid "Copied: {text}"
msgstr "Скопировано: {text}"

#: app/companion/model.py:681
msgid ""
"WSL needs a restart to recover the audio. Use Restart WSL now... in the "
"menu."
msgstr ""
"Чтобы вернуть звук, нужно перезапустить WSL. Выберите в меню "
"«Перезапустить WSL сейчас...»."

#: app/companion/model.py:719
msgid "No microphone is connected. Connect one and try again."
msgstr "Микрофон не подключён. Подключите его и повторите попытку."

#: app/companion/model.py:723
msgid ""
"The engine could not open the microphone. Allow desktop apps to use the "
"microphone in the Windows privacy settings, and close any app that holds "
"it exclusively."
msgstr ""
"Движку не удалось открыть микрофон. Разрешите классическим приложениям "
"доступ к микрофону в параметрах конфиденциальности Windows и закройте "
"приложения, которые используют его монопольно."

#: app/companion/model.py:726
msgid ""
"The engine could not open the microphone. Close any app that holds it "
"exclusively."
msgstr ""
"Движку не удалось открыть микрофон. Закройте приложения, которые "
"используют его монопольно."

#: app/companion/model.py:728
msgid ""
"The engine could not open the microphone: the audio server is not "
"responding."
msgstr "Движку не удалось открыть микрофон: аудиосервер не отвечает."

#: app/companion/model.py:731
msgid ""
"Windows has a microphone, but WSL cannot open it: its audio bridge is "
"stuck. Restarting WSL fixes it."
msgstr ""
"В Windows есть микрофон, но WSL не может его открыть: аудиомост завис. "
"Перезапуск WSL это исправит."

#: app/companion/model.py:733
msgid ""
"WSL cannot open the microphone. If one is connected, restarting WSL fixes"
" it."
msgstr ""
"WSL не может открыть микрофон. Если микрофон подключён, перезапуск WSL "
"это исправит."

#: app/companion/model.py:742
msgid "VoiceMate is starting"
msgstr "VoiceMate запускается"

#: app/companion/model.py:743
msgid "The engine is still loading. Try again in a moment."
msgstr "Движок ещё загружается. Повторите попытку через несколько секунд."

#: app/companion/model.py:750
msgid "The engine is not running. Use Restart engine in the menu."
msgstr "Движок не запущен. Выберите в меню «Перезапустить движок»."

#: app/companion/model.py:756 app/companion/model.py:763
msgid "VoiceMate stopped retrying"
msgstr "VoiceMate прекратил попытки"

#: app/companion/model.py:765
msgid ""
"Restarting WSL did not bring the audio back. Check the engine log, then "
"use Restart WSL... in the Engine menu."
msgstr ""
"Перезапуск WSL не вернул звук. Посмотрите журнал движка, затем выберите "
"«Перезапустить WSL...» в меню «Движок»."

#: app/companion/model.py:773
msgid "VoiceMate could not find the engine. Set the engine folder in Settings."
msgstr "VoiceMate не нашёл движок. Укажите папку движка в настройках."

#: app/companion/model.py:779
msgid "Could not start the engine"
msgstr "Не удалось запустить движок"

#: app/companion/model.py:780
msgid ""
"Starting the engine failed. VoiceMate will try again; the engine log has "
"the details."
msgstr ""
"Не удалось запустить движок. VoiceMate попробует снова; подробности в "
"журнале движка."

#: app/companion/model.py:786
msgid "Restarting WSL"
msgstr "Перезапуск WSL"

#: app/companion/model.py:787
msgid ""
"WSL lost its audio, so VoiceMate is restarting it. This takes a few "
"seconds."
msgstr ""
"WSL потерял звук, поэтому VoiceMate перезапускает его. Это займёт "
"несколько секунд."

#: app/companion/model.py:793 app/companion/model.py:800
