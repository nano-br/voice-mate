msgstr "[VoiceMate] No se pudo detener el listener: {exc}"

#: app/cli/config_builder.py:125
msgid "[VoiceMate] ⚠ Claude flow requires input-method=keyboard. Disabling."
msgstr ""
"[VoiceMate] ⚠ El flujo de Claude requiere input-method=keyboard. "
"Desactivándolo."

#: app/cli/config_builder.py:144
msgid ""
"[VoiceMate] ⚠ --claude-no-system-prompt and --claude-system-prompt were "
"passed together; using --claude-no-system-prompt."
msgstr ""
"[VoiceMate] ⚠ Se pasaron --claude-no-system-prompt y --claude-system-"
"prompt juntos; usando --claude-no-system-prompt."

#: app/cli/config_builder.py:257
#, python-brace-format
msgid "[VoiceMate] Auto-seed removed: {path}"
msgstr "[VoiceMate] Auto-seed eliminado: {path}"

#: app/cli/config_builder.py:260
#, python-brace-format
msgid "[VoiceMate] ⚠ Failed to remove {path}: {exc}"
msgstr "[VoiceMate] ⚠ No se pudo eliminar {path}: {exc}"

#: app/cli/wiring.py:71
msgid ""
"[VoiceMate]   Install the GPU mode from the companion or with `make stt-"
"install MODE=gpu`."
msgstr ""
"[VoiceMate]   Instala el modo GPU desde la app o con `make stt-install "
"MODE=gpu`."

#: app/cli/wiring.py:83
#, python-brace-format
msgid "[VoiceMate] ⚠ openai-whisper failed: {exc}"
msgstr "[VoiceMate] ⚠ Falló openai-whisper: {exc}"

#: app/cli/wiring.py:90
msgid ""
"[VoiceMate] ⚠ whisper.cpp not found (run `make configure`); trying "
"fallback."
msgstr ""
"[VoiceMate] ⚠ No se encontró whisper.cpp (ejecuta `make configure`); "
"probando la alternativa."

#: app/cli/wiring.py:97
#, python-brace-format
msgid "[VoiceMate] ⚠ whisper.cpp failed; falling back: {exc}"
msgstr "[VoiceMate] ⚠ Falló whisper.cpp; recurriendo a la alternativa: {exc}"

#: app/cli/wiring.py:117
#, python-brace-format
msgid "[VoiceMate] ⚠ faster-whisper (CT2-ROCm) failed on the AMD GPU: {exc}"
msgstr "[VoiceMate] ⚠ faster-whisper (CT2-ROCm) falló en la GPU AMD: {exc}"

#: app/cli/wiring.py:120
msgid "[VoiceMate]   Disabling until the next `make configure`."
msgstr "[VoiceMate]   Desactivado hasta el próximo `make configure`."

#: app/cli/wiring.py:127
#, python-brace-format
msgid "[VoiceMate] ⚠ Failed to persist ct2_rocm_ok: {persist_exc}"
msgstr "[VoiceMate] ⚠ No se pudo guardar ct2_rocm_ok: {persist_exc}"

#: app/cli/wiring.py:168
msgid ""
"[VoiceMate] ⚠ No GPU backend available on AMD; using faster-whisper on "
"CPU."
msgstr ""
"[VoiceMate] ⚠ No hay ningún backend de GPU disponible en AMD; usando "
"faster-whisper en la CPU."

#: app/cli/wiring.py:190
msgid "[VoiceMate] ⚠ GPU mode requested but no supported GPU was found."
msgstr ""
"[VoiceMate] ⚠ Se pidió el modo GPU, pero no se encontró ninguna GPU "
"compatible."

#: app/cli/wiring.py:223
#, python-brace-format
msgid "[VoiceMate] ⚠ TTS disabled: engine '{engine}' packages not installed."
msgstr ""
"[VoiceMate] ⚠ TTS desactivado: los paquetes del motor '{engine}' no están"
" instalados."

#: app/cli/wiring.py:227
#, python-brace-format
msgid ""
"[VoiceMate]   Install with: poetry install --extras {extra} (or run with "
"--no-tts)."
msgstr ""
"[VoiceMate]   Instala con: poetry install --extras {extra} (o ejecuta con"
" --no-tts)."

#: app/cli/wiring.py:237
#, python-brace-format
msgid "[VoiceMate] ⚠ TTS disabled (failed to start engine '{engine}'): {exc}"
msgstr ""
"[VoiceMate] ⚠ TTS desactivado (no se pudo iniciar el motor '{engine}'): "
"{exc}"

#: app/cli/wiring.py:244
#, python-brace-format
msgid ""
"[VoiceMate]   Check `poetry install --extras {extra}`, GPU availability, "
"or run with `--no-tts`."
msgstr ""
"[VoiceMate]   Verifica `poetry install --extras {extra}`, la "
"disponibilidad de la GPU, o ejecuta con `--no-tts`."

#: app/cli/wiring.py:284
msgid "[VoiceMate] ⚠ Claude flow disabled: extra 'claude' not installed."
msgstr ""
"[VoiceMate] ⚠ Flujo de Claude desactivado: el extra 'claude' no está "
"instalado."

#: app/cli/wiring.py:288
msgid "[VoiceMate]   Install with: poetry install --extras claude"
msgstr "[VoiceMate]   Instala con: poetry install --extras claude"

#: app/cli/wiring.py:304
#, python-brace-format
msgid "[VoiceMate] ⚠ Failed to start Claude (run `claude login`): {exc}"
msgstr "[VoiceMate] ⚠ No se pudo iniciar Claude (ejecuta `claude login`): {exc}"

#: app/cli/wiring.py:316
#, python-brace-format
msgid "[VoiceMate] ⚠ Unknown flow ignored: {kind}"
msgstr "[VoiceMate] ⚠ Flujo desconocido ignorado: {kind}"

#: app/cli/wiring.py:355
#, python-brace-format
msgid ""
"[VoiceMate] ⚠ --input-method mouse is only supported on Windows "
"(trigger={trigger}); using keyboard hotkeys."
msgstr ""
"[VoiceMate] ⚠ --input-method mouse solo es compatible con Windows "
"(trigger={trigger}); usando atajos de teclado."

#: app/companion/controller.py:629
msgid ""
"The settings file was written by a newer version of VoiceMate, so it is "
"read-only here."
msgstr ""
"El archivo de configuración lo escribió una versión más nueva de "
"VoiceMate, así que aquí es de solo lectura."

#: app/companion/controller.py:648
msgid "Could not save the settings file."
msgstr "No se pudo guardar el archivo de configuración."

#: app/companion/controller.py:676
#, python-brace-format
msgid "{hotkey} is already used by another app."
msgstr "Otra aplicación ya usa {hotkey}."

#: app/companion/controller.py:741
msgid "Could not change the start at login setting."
msgstr "No se pudo cambiar la opción de iniciar al entrar en la sesión."

#: app/companion/cues.py:80 app/companion/ui/texts.py:151
msgid "Recording started"
msgstr "Grabación iniciada"

#: app/companion/cues.py:81 app/companion/ui/texts.py:152
msgid "Transcribing"
msgstr "Transcribiendo"

#: app/companion/cues.py:82 app/companion/ui/texts.py:106
#: app/companion/ui/texts.py:153
msgid "Copied"
msgstr "Copiado"

#: app/companion/cues.py:83 app/companion/ui/texts.py:154
msgid "Claude answered"
msgstr "Claude respondió"

#: app/companion/cues.py:84 app/companion/ui/texts.py:155
msgid "Warning"
msgstr "Advertencia"

#: app/companion/cues.py:85 app/companion/ui/texts.py:156
msgid "Error"
msgstr "Error"

#: app/companion/main.py:130
#, python-brace-format
msgid ""
"VoiceMate cannot find its data folder: {variable} is not set and the home"
" folder is unknown. Set {variable} or {home_variable} for your user and "
"start VoiceMate again."
msgstr ""
"VoiceMate no encuentra su carpeta de datos: {variable} no está definida y"
" la carpeta personal es desconocida. Define {variable} o {home_variable} "
"para tu usuario y vuelve a abrir VoiceMate."

#: app/companion/main.py:193
msgid "Settings"
msgstr "Configuración"

#: app/companion/main.py:193 app/companion/ui/status_window.py:122
#: app/companion/ui/status_window.py:180 app/companion/ui/tray.py:112
msgid "Restart engine"
msgstr "Reiniciar el motor"

#: app/companion/main.py:195 app/companion/ui/tray.py:114
msgid "Restart WSL..."
msgstr "Reiniciar WSL..."

#: app/companion/main.py:196 app/companion/ui/status_window.py:184
#: app/companion/ui/tray.py:122
msgid "Quit VoiceMate"
msgstr "Salir de VoiceMate"

#: app/companion/model.py:611
msgid "Engine not responding"
msgstr "El motor no responde"

#: app/companion/model.py:611
msgid "No answer from the engine. VoiceMate restarts it if this continues."
msgstr "El motor no responde. VoiceMate lo reiniciará si esto continúa."

#: app/companion/model.py:613 app/companion/model.py:810
msgid "Engine is outdated"
msgstr "Motor desactualizado"

#: app/companion/model.py:613
msgid "The engine is older than this app. Update it, then use Restart engine."
msgstr ""
"El motor es más antiguo que esta aplicación. Actualízalo y luego usa "
"Reiniciar el motor."

#: app/companion/model.py:616 app/companion/model.py:916
#: app/companion/ui/texts.py:109
msgid "No microphone"
msgstr "Sin micrófono"

#: app/companion/model.py:616
msgid "Connect a microphone to record."
msgstr "Conecta un micrófono para grabar."

#: app/companion/model.py:619 app/companion/model.py:903
#: app/companion/ui/demo_controller.py:351 app/companion/ui/texts.py:111
msgid "WSL audio stopped"
msgstr "El audio de WSL se detuvo"

#: app/companion/model.py:619
msgid "WSL lost its audio bridge. Restarting WSL brings it back."
msgstr "WSL perdió su puente de audio. Reiniciar WSL lo recupera."

#: app/companion/model.py:620 app/companion/model.py:909
msgid "Audio server is down"
msgstr "El servidor de audio no funciona"

#: app/companion/model.py:620
msgid "The engine cannot reach the audio server."
msgstr "El motor no puede acceder al servidor de audio."

#: app/companion/model.py:622 app/companion/model.py:626
#: app/companion/model.py:627 app/companion/model.py:889
msgid "Microphone unavailable"
msgstr "Micrófono no disponible"

#: app/companion/model.py:623
msgid ""
"Check the privacy settings for microphone access by desktop apps, and "
"close any app that holds the microphone."
msgstr ""
"Revisa en la configuración de privacidad si las aplicaciones de "
"escritorio pueden usar el micrófono y cierra cualquier aplicación que lo "
"esté ocupando."

#: app/companion/model.py:626
msgid "WSL cannot open the microphone. Restarting WSL fixes it."
msgstr "WSL no puede abrir el micrófono. Reiniciar WSL lo soluciona."

#: app/companion/model.py:627
msgid "The engine cannot open the microphone."
msgstr "El motor no puede abrir el micrófono."

#: app/companion/model.py:632
msgid "The engine stopped unexpectedly."
msgstr "El motor se detuvo inesperadamente."

#: app/companion/model.py:633
msgid "The engine stopped answering."
msgstr "El motor dejó de responder."

#: app/companion/model.py:634
msgid "The engine took too long to start."
msgstr "El motor tardó demasiado en iniciar."

#: app/companion/model.py:635
msgid "Restarting WSL to recover the audio."
msgstr "Reiniciando WSL para recuperar el audio."

#: app/companion/model.py:636
msgid "Restart requested."
msgstr "Reinicio solicitado."

#: app/companion/model.py:637
msgid "Restarting WSL."
msgstr "Reiniciando WSL."

#: app/companion/model.py:638
msgid "The engine is restarting."
msgstr "El motor se está reiniciando."

#: app/companion/model.py:645 app/companion/model.py:772
msgid "Engine folder not found"
msgstr "No se encontró la carpeta del motor"

#: app/companion/model.py:645
msgid "Set the engine folder in Settings."
msgstr "Indica la carpeta del motor en Configuración."

#: app/companion/model.py:647 app/companion/model.py:650
msgid "Engine failed"
msgstr "Falló el motor"

#: app/companion/model.py:648
msgid ""
"Restarting WSL did not help. Check the engine log, then use Restart "
"WSL... in the Engine menu."
msgstr ""
"Reiniciar WSL no ayudó. Revisa el registro del motor y luego usa "
"Reiniciar WSL... en el menú Motor."

#: app/companion/model.py:650 app/companion/model.py:757
msgid ""
"The engine failed too many times. Check the engine log, then use Restart "
"engine."
msgstr ""
"El motor falló demasiadas veces. Revisa el registro del motor y luego usa"
" Reiniciar el motor."

#: app/companion/model.py:656 app/companion/model.py:749
#: app/companion/ui/texts.py:87
msgid "VoiceMate is stopped"
msgstr "VoiceMate está detenido"

#: app/companion/model.py:658 app/companion/ui/texts.py:89
msgid "Starting engine..."
msgstr "Iniciando el motor..."

#: app/companion/model.py:660
#, python-brace-format
msgid "Waiting for the engine on port {port}."
msgstr "Esperando al motor en el puerto {port}."

#: app/companion/model.py:662 app/companion/ui/texts.py:93
#, python-brace-format
msgid "Restarting (attempt {attempt})"
msgstr "Reiniciando (intento {attempt})"

#: app/companion/model.py:666
#, python-brace-format
msgid "Listening for {hotkey}"
msgstr "Esperando {hotkey}"

#: app/companion/model.py:666 app/companion/ui/texts.py:98
msgid "Ready"
msgstr "Listo"

#: app/companion/model.py:669 app/companion/ui/texts.py:79
#, python-brace-format
msgid "Recording {elapsed}"
msgstr "Grabando {elapsed}"

#: app/companion/model.py:671 app/companion/ui/texts.py:100
msgid "Transcribing..."
msgstr "Transcribiendo..."

#: app/companion/model.py:673 app/companion/ui/texts.py:102
msgid "Claude is answering..."
msgstr "Claude está respondiendo..."

#: app/companion/model.py:675 app/companion/ui/texts.py:105
#, python-brace-format
msgid "Copied: {text}"
msgstr "Copiado: {text}"

#: app/companion/model.py:681
msgid ""
"WSL needs a restart to recover the audio. Use Restart WSL now... in the "
"menu."
msgstr ""
"WSL necesita reiniciarse para recuperar el audio. Usa Reiniciar WSL "
"ahora... en el menú."

#: app/companion/model.py:719
msgid "No microphone is connected. Connect one and try again."
msgstr "No hay ningún micrófono conectado. Conecta uno e inténtalo de nuevo."

#: app/companion/model.py:723
msgid ""
"The engine could not open the microphone. Allow desktop apps to use the "
"microphone in the Windows privacy settings, and close any app that holds "
"it exclusively."
msgstr ""
"El motor no pudo abrir el micrófono. Permite que las aplicaciones de "
"escritorio usen el micrófono en la configuración de privacidad de Windows"
" y cierra cualquier aplicación que lo use en exclusiva."

#: app/companion/model.py:726
msgid ""
"The engine could not open the microphone. Close any app that holds it "
"exclusively."
msgstr ""
"El motor no pudo abrir el micrófono. Cierra cualquier aplicación que lo "
"use en exclusiva."

#: app/companion/model.py:728
msgid ""
"The engine could not open the microphone: the audio server is not "
"responding."
msgstr "El motor no pudo abrir el micrófono: el servidor de audio no responde."

#: app/companion/model.py:731
msgid ""
"Windows has a microphone, but WSL cannot open it: its audio bridge is "
"stuck. Restarting WSL fixes it."
msgstr ""
"Windows tiene un micrófono, pero WSL no puede abrirlo: su puente de audio"
" se bloqueó. Reiniciar WSL lo soluciona."

#: app/companion/model.py:733
msgid ""
"WSL cannot open the microphone. If one is connected, restarting WSL fixes"
" it."
msgstr ""
"WSL no puede abrir el micrófono. Si hay uno conectado, reiniciar WSL lo "
"soluciona."

#: app/companion/model.py:742
msgid "VoiceMate is starting"
msgstr "VoiceMate se está iniciando"

#: app/companion/model.py:743
msgid "The engine is still loading. Try again in a moment."
msgstr "El motor todavía se está cargando. Inténtalo de nuevo en un momento."

#: app/companion/model.py:750
msgid "The engine is not running. Use Restart engine in the menu."
msgstr "El motor no está en ejecución. Usa Reiniciar el motor en el menú."

#: app/companion/model.py:756 app/companion/model.py:763
msgid "VoiceMate stopped retrying"
msgstr "VoiceMate dejó de reintentar"

#: app/companion/model.py:765
msgid ""
"Restarting WSL did not bring the audio back. Check the engine log, then "
"use Restart WSL... in the Engine menu."
msgstr ""
"Reiniciar WSL no recuperó el audio. Revisa el registro del motor y luego "
"usa Reiniciar WSL... en el menú Motor."

#: app/companion/model.py:773
msgid "VoiceMate could not find the engine. Set the engine folder in Settings."
msgstr ""
"VoiceMate no encontró el motor. Indica la carpeta del motor en "
"Configuración."

#: app/companion/model.py:779
msgid "Could not start the engine"
msgstr "No se pudo iniciar el motor"

#: app/companion/model.py:780
msgid ""
"Starting the engine failed. VoiceMate will try again; the engine log has "
"the details."
msgstr ""
"Falló el inicio del motor. VoiceMate lo volverá a intentar; el registro "
"del motor tiene los detalles."

#: app/companion/model.py:786
msgid "Restarting WSL"
msgstr "Reiniciando WSL"

#: app/companion/model.py:787
msgid ""
"WSL lost its audio, so VoiceMate is restarting it. This takes a few "
"seconds."
msgstr ""
"WSL perdió el audio, así que VoiceMate lo está reiniciando. Esto tarda "
"unos segundos."

#: app/companion/model.py:793 app/companion/model.py:800
msgid "WSL needs a restart"
msgstr "WSL necesita reiniciarse"

#: app/companion/model.py:794
msgid "WSL lost its audio. Choose Restart WSL now... in the VoiceMate menu."
msgstr "WSL perdió el audio. Elige Reiniciar WSL ahora... en el menú de VoiceMate."

#: app/companion/model.py:802
#, python-brace-format
msgid ""
"WSL lost its audio, but restarting it also stops {distros}. Choose "
"Restart WSL now... in the VoiceMate menu when convenient."
msgstr ""
"WSL perdió el audio, pero reiniciarlo también detiene {distros}. Elige "
"Reiniciar WSL ahora... en el menú de VoiceMate cuando te convenga."

#: app/companion/model.py:811
msgid ""
"The engine is older than this app. Update it, then use Restart engine in "
"the menu."
msgstr ""
"El motor es más antiguo que esta aplicación. Actualízalo y luego usa "
"Reiniciar el motor en el menú."

#: app/companion/model.py:817
msgid "Engine run by systemd"
msgstr "Motor ejecutado por systemd"

#: app/companion/model.py:819
msgid ""
"A systemd service runs the engine, so VoiceMate attaches to it. To let "
"VoiceMate manage it, run `systemctl --user disable --now voicemate` in "
"WSL."
msgstr ""
"Un servicio de systemd ejecuta el motor, así que VoiceMate se conecta a "
"él. Para que VoiceMate lo gestione, ejecuta `systemctl --user disable "
"--now voicemate` en WSL."

#: app/companion/model.py:827
msgid "Engine access denied"
msgstr "Acceso al motor denegado"

#: app/companion/model.py:829
msgid ""
"The engine refused VoiceMate's access token. VoiceMate reads "
"`~/.config/voicemate/api-token` again every 30 seconds; the engine log "
"has the details."
msgstr ""
"El motor rechazó el token de acceso de VoiceMate. VoiceMate vuelve a leer"
" `~/.config/voicemate/api-token` cada 30 segundos; el registro del motor "
"tiene los detalles."

#: app/companion/model.py:837
msgid "Settings reset"
msgstr "Configuración restablecida"

#: app/companion/model.py:839
#, python-brace-format
msgid ""
"The settings file could not be read, so VoiceMate started with the "
"default settings. The old file was kept as {path}."
msgstr ""
"No se pudo leer el archivo de configuración, así que VoiceMate se inició "
"con la configuración predeterminada. El archivo anterior se guardó como "
"{path}."

#: app/companion/model.py:847
msgid "\"Not copied\" list reset"
msgstr "Lista \"No copiadas\" restablecida"

