msgid ""
"[VoiceMate] Register the Windows-side hotkeys with scripts/windows"
"/voicemate-hotkeys.ahk (or .ps1)."
msgstr ""
"[VoiceMate] Registra los atajos del lado de Windows con scripts/windows"
"/voicemate-hotkeys.ahk (o .ps1)."

#: app/main.py:235
