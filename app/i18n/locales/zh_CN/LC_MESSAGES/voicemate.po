#, python-brace-format
msgid "[VoiceMate] ⚠ openai-whisper failed: {exc}"
msgstr "[VoiceMate] ⚠ openai-whisper 失败：{exc}"

#: app/cli/wiring.py:67
msgid ""
"[VoiceMate] ⚠ whisper.cpp not found (run `make configure`); trying "
"fallback."
msgstr "[VoiceMate] ⚠ 未找到 whisper.cpp（请运行 `make configure`）；正在尝试备用方案。"

#: app/cli/wiring.py:74
#, python-brace-format
msgid "[VoiceMate] ⚠ whisper.cpp failed; falling back: {exc}"
msgstr "[VoiceMate] ⚠ whisper.cpp 失败，正在回退：{exc}"

#: app/cli/wiring.py:94
#, python-brace-format
msgid "[VoiceMate] ⚠ faster-whisper (CT2-ROCm) failed on the AMD GPU: {exc}"
msgstr "[VoiceMate] ⚠ faster-whisper（CT2-ROCm）在 AMD GPU 上运行失败：{exc}"

#: app/cli/wiring.py:97
msgid "[VoiceMate]   Disabling until the next `make configure`."
msgstr "[VoiceMate]   在下次运行 `make configure` 之前将保持禁用。"

#: app/cli/wiring.py:104
#, python-brace-format
msgid "[VoiceMate] ⚠ Failed to persist ct2_rocm_ok: {persist_exc}"
msgstr "[VoiceMate] ⚠ 无法保存 ct2_rocm_ok：{persist_exc}"

#: app/cli/wiring.py:145
msgid ""
"[VoiceMate] ⚠ No GPU backend available on AMD; using faster-whisper on "
"CPU."
msgstr "[VoiceMate] ⚠ AMD 上没有可用的 GPU 后端；改用 CPU 上的 faster-whisper。"

#: app/cli/wiring.py:182
#, python-brace-format
msgid "[VoiceMate] ⚠ TTS disabled: engine '{engine}' packages not installed."
msgstr "[VoiceMate] ⚠ TTS 已禁用：未安装引擎“{engine}”的软件包。"

#: app/cli/wiring.py:186
#, python-brace-format
msgid ""
"[VoiceMate]   Install with: poetry install --extras {extra} (or run with "
"--no-tts)."
msgstr "[VoiceMate]   安装方法：poetry install --extras {extra}（或使用 --no-tts 运行）。"

#: app/cli/wiring.py:196
#, python-brace-format
msgid "[VoiceMate] ⚠ TTS disabled (failed to start engine '{engine}'): {exc}"
msgstr "[VoiceMate] ⚠ TTS 已禁用（引擎“{engine}”启动失败）：{exc}"

#: app/cli/wiring.py:203
#, python-brace-format
msgid ""
"[VoiceMate]   Check `poetry install --extras {extra}`, GPU availability, "
"or run with `--no-tts`."
msgstr ""
"[VoiceMate]   请检查 `poetry install --extras {extra}`、GPU 是否可用，或使用 `--no-"
"tts` 运行。"

#: app/cli/wiring.py:243
msgid "[VoiceMate] ⚠ Claude flow disabled: extra 'claude' not installed."
msgstr "[VoiceMate] ⚠ Claude 流程已禁用：未安装 extra“claude”。"

#: app/cli/wiring.py:247
msgid "[VoiceMate]   Install with: poetry install --extras claude"
msgstr "[VoiceMate]   安装方法：poetry install --extras claude"

#: app/cli/wiring.py:263
#, python-brace-format
msgid "[VoiceMate] ⚠ Failed to start Claude (run `claude login`): {exc}"
msgstr "[VoiceMate] ⚠ 无法启动 Claude（请运行 `claude login`）：{exc}"

#: app/cli/wiring.py:275
#, python-brace-format
msgid "[VoiceMate] ⚠ Unknown flow ignored: {kind}"
msgstr "[VoiceMate] ⚠ 已忽略未知流程：{kind}"

#: app/cli/wiring.py:314
#, python-brace-format
msgid ""
"[VoiceMate] ⚠ --input-method mouse is only supported on Windows "
"(trigger={trigger}); using keyboard hotkeys."
msgstr ""
"[VoiceMate] ⚠ --input-method mouse 仅在 Windows "
"上受支持（trigger={trigger}）；改用键盘快捷键。"

#: app/companion/controller.py:616
msgid ""
"The settings file was written by a newer version of VoiceMate, so it is "
"read-only here."
msgstr "设置文件由更新版本的 VoiceMate 写入，因此在此处为只读。"

#: app/companion/controller.py:635
msgid "Could not save the settings file."
msgstr "无法保存设置文件。"

#: app/companion/controller.py:663
#, python-brace-format
msgid "{hotkey} is already used by another app."
msgstr "{hotkey} 已被其他应用占用。"

#: app/companion/controller.py:728
msgid "Could not change the start at login setting."
msgstr "无法更改“登录时启动 VoiceMate”设置。"

#: app/companion/cues.py:80 app/companion/ui/texts.py:151
msgid "Recording started"
msgstr "开始录音"

#: app/companion/cues.py:81 app/companion/ui/texts.py:152
msgid "Transcribing"
msgstr "转写中"

#: app/companion/cues.py:82 app/companion/ui/texts.py:106
#: app/companion/ui/texts.py:153
msgid "Copied"
msgstr "已复制"

#: app/companion/cues.py:83 app/companion/ui/texts.py:154
msgid "Claude answered"
msgstr "Claude 已回答"

#: app/companion/cues.py:84 app/companion/ui/texts.py:155
msgid "Warning"
msgstr "警告"

#: app/companion/cues.py:85 app/companion/ui/texts.py:156
