#: app/companion/model.py:592
msgid "Engine not responding"
msgstr "引擎无响应"

#: app/companion/model.py:592
msgid "No answer from the engine. VoiceMate restarts it if this continues."
msgstr "引擎没有应答。如果一直如此，VoiceMate 会重启引擎。"

#: app/companion/model.py:594 app/companion/model.py:790
msgid "Engine is outdated"
msgstr "引擎版本过旧"

#: app/companion/model.py:594
msgid "The engine is older than this app. Update it, then use Restart engine."
msgstr "引擎版本比此应用旧。请更新引擎，然后使用“重启引擎”。"

#: app/companion/model.py:597 app/companion/model.py:896
#: app/companion/ui/texts.py:109
msgid "No microphone"
msgstr "没有麦克风"

#: app/companion/model.py:597
msgid "Connect a microphone to record."
msgstr "请连接麦克风以进行录音。"

#: app/companion/model.py:600 app/companion/model.py:883
#: app/companion/ui/demo_controller.py:333 app/companion/ui/texts.py:111
msgid "WSL audio stopped"
msgstr "WSL 音频已停止"

#: app/companion/model.py:600
msgid "WSL lost its audio bridge. Restarting WSL brings it back."
msgstr "WSL 的音频桥接已断开。重启 WSL 即可恢复。"

#: app/companion/model.py:601 app/companion/model.py:889
msgid "Audio server is down"
msgstr "音频服务器未运行"

#: app/companion/model.py:601
msgid "The engine cannot reach the audio server."
msgstr "引擎无法连接音频服务器。"

#: app/companion/model.py:603 app/companion/model.py:607
#: app/companion/model.py:608 app/companion/model.py:869
msgid "Microphone unavailable"
msgstr "麦克风不可用"

#: app/companion/model.py:604
msgid ""
"Check the privacy settings for microphone access by desktop apps, and "
"close any app that holds the microphone."
msgstr "请检查隐私设置中桌面应用的麦克风访问权限，并关闭正在占用麦克风的应用。"

#: app/companion/model.py:607
msgid "WSL cannot open the microphone. Restarting WSL fixes it."
msgstr "WSL 无法打开麦克风。重启 WSL 即可解决。"

#: app/companion/model.py:608
msgid "The engine cannot open the microphone."
msgstr "引擎无法打开麦克风。"

#: app/companion/model.py:613
msgid "The engine stopped unexpectedly."
msgstr "引擎意外停止。"

#: app/companion/model.py:614
msgid "The engine stopped answering."
msgstr "引擎不再应答。"

#: app/companion/model.py:615
msgid "The engine took too long to start."
msgstr "引擎启动时间过长。"

#: app/companion/model.py:616
msgid "Restarting WSL to recover the audio."
msgstr "正在重启 WSL 以恢复音频。"

#: app/companion/model.py:617
msgid "Restart requested."
msgstr "已请求重启。"

#: app/companion/model.py:618
msgid "Restarting WSL."
msgstr "正在重启 WSL。"

#: app/companion/model.py:619
msgid "The engine is restarting."
msgstr "引擎正在重启。"

#: app/companion/model.py:626 app/companion/model.py:752
msgid "Engine folder not found"
msgstr "未找到引擎文件夹"

#: app/companion/model.py:626
msgid "Set the engine folder in Settings."
msgstr "请在设置中指定引擎文件夹。"

#: app/companion/model.py:628 app/companion/model.py:631
msgid "Engine failed"
msgstr "引擎故障"

#: app/companion/model.py:629
msgid ""
"Restarting WSL did not help. Check the engine log, then use Restart "
"WSL... in the Engine menu."
msgstr "重启 WSL 未能解决问题。请查看引擎日志，然后使用“引擎”菜单中的“重启 WSL...”。"

#: app/companion/model.py:631 app/companion/model.py:737
msgid ""
"The engine failed too many times. Check the engine log, then use Restart "
"engine."
msgstr "引擎失败次数过多。请查看引擎日志，然后使用“重启引擎”。"

#: app/companion/model.py:637 app/companion/model.py:729
#: app/companion/ui/texts.py:87
msgid "VoiceMate is stopped"
msgstr "VoiceMate 已停止"

#: app/companion/model.py:639 app/companion/ui/texts.py:89
msgid "Starting engine..."
msgstr "正在启动引擎..."

#: app/companion/model.py:641
#, python-brace-format
msgid "Waiting for the engine on port {port}."
msgstr "正在等待端口 {port} 上的引擎。"

#: app/companion/model.py:643 app/companion/ui/texts.py:93
#, python-brace-format
msgid "Restarting (attempt {attempt})"
msgstr "正在重启（第 {attempt} 次尝试）"

#: app/companion/model.py:647
#, python-brace-format
msgid "Listening for {hotkey}"
msgstr "等待按下 {hotkey}"

#: app/companion/model.py:647 app/companion/ui/texts.py:98
msgid "Ready"
msgstr "就绪"

#: app/companion/model.py:650 app/companion/ui/texts.py:79
#, python-brace-format
msgid "Recording {elapsed}"
msgstr "录音中 {elapsed}"

#: app/companion/model.py:652 app/companion/ui/texts.py:100
msgid "Transcribing..."
msgstr "正在转写..."

#: app/companion/model.py:654 app/companion/ui/texts.py:102
msgid "Claude is answering..."
msgstr "Claude 正在回答..."

#: app/companion/model.py:656 app/companion/ui/texts.py:105
#, python-brace-format
msgid "Copied: {text}"
msgstr "已复制：{text}"

#: app/companion/model.py:662
msgid ""
"WSL needs a restart to recover the audio. Use Restart WSL now... in the "
"menu."
msgstr "WSL 需要重启才能恢复音频。请使用菜单中的“立即重启 WSL...”。"

#: app/companion/model.py:699
msgid "No microphone is connected. Connect one and try again."
msgstr "未连接麦克风。请连接麦克风后重试。"

#: app/companion/model.py:703
msgid ""
"The engine could not open the microphone. Allow desktop apps to use the "
"microphone in the Windows privacy settings, and close any app that holds "
"it exclusively."
msgstr "引擎无法打开麦克风。请在 Windows 隐私设置中允许桌面应用使用麦克风，并关闭独占麦克风的应用。"

#: app/companion/model.py:706
msgid ""
"The engine could not open the microphone. Close any app that holds it "
"exclusively."
msgstr "引擎无法打开麦克风。请关闭独占麦克风的应用。"

#: app/companion/model.py:708
msgid ""
"The engine could not open the microphone: the audio server is not "
"responding."
msgstr "引擎无法打开麦克风：音频服务器没有响应。"

#: app/companion/model.py:711
msgid ""
"Windows has a microphone, but WSL cannot open it: its audio bridge is "
"stuck. Restarting WSL fixes it."
msgstr "Windows 有麦克风，但 WSL 无法打开它：WSL 的音频桥接卡住了。重启 WSL 即可解决。"

#: app/companion/model.py:713
msgid ""
"WSL cannot open the microphone. If one is connected, restarting WSL fixes"
" it."
msgstr "WSL 无法打开麦克风。如果已连接麦克风，重启 WSL 即可解决。"

#: app/companion/model.py:722
msgid "VoiceMate is starting"
msgstr "VoiceMate 正在启动"

#: app/companion/model.py:723
msgid "The engine is still loading. Try again in a moment."
msgstr "引擎仍在加载。请稍后再试。"

#: app/companion/model.py:730
msgid "The engine is not running. Use Restart engine in the menu."
msgstr "引擎未运行。请使用菜单中的“重启引擎”。"

#: app/companion/model.py:736 app/companion/model.py:743
msgid "VoiceMate stopped retrying"
msgstr "VoiceMate 已停止重试"

#: app/companion/model.py:745
msgid ""
"Restarting WSL did not bring the audio back. Check the engine log, then "
"use Restart WSL... in the Engine menu."
msgstr "重启 WSL 后音频仍未恢复。请查看引擎日志，然后使用“引擎”菜单中的“重启 WSL...”。"

#: app/companion/model.py:753
msgid "VoiceMate could not find the engine. Set the engine folder in Settings."
msgstr "VoiceMate 找不到引擎。请在设置中指定引擎文件夹。"

#: app/companion/model.py:759
msgid "Could not start the engine"
msgstr "无法启动引擎"

#: app/companion/model.py:760
msgid ""
"Starting the engine failed. VoiceMate will try again; the engine log has "
"the details."
msgstr "引擎启动失败。VoiceMate 会再次尝试；详细信息请查看引擎日志。"

#: app/companion/model.py:766
msgid "Restarting WSL"
msgstr "正在重启 WSL"

#: app/companion/model.py:767
msgid ""
"WSL lost its audio, so VoiceMate is restarting it. This takes a few "
"seconds."
msgstr "WSL 的音频已丢失，VoiceMate 正在重启 WSL。这需要几秒钟。"

#: app/companion/model.py:773 app/companion/model.py:780
msgid "WSL needs a restart"
msgstr "WSL 需要重启"

#: app/companion/model.py:774
msgid "WSL lost its audio. Choose Restart WSL now... in the VoiceMate menu."
msgstr "WSL 的音频已丢失。请在 VoiceMate 菜单中选择“立即重启 WSL...”。"

#: app/companion/model.py:782
#, python-brace-format
msgid ""
"WSL lost its audio, but restarting it also stops {distros}. Choose "
"Restart WSL now... in the VoiceMate menu when convenient."
msgstr "WSL 的音频已丢失，但重启 WSL 也会停止 {distros}。请在方便时于 VoiceMate 菜单中选择“立即重启 WSL...”。"

#: app/companion/model.py:791
msgid ""
"The engine is older than this app. Update it, then use Restart engine in "
"the menu."
msgstr "引擎版本比此应用旧。请更新引擎，然后使用菜单中的“重启引擎”。"

#: app/companion/model.py:797
msgid "Engine run by systemd"
msgstr "引擎由 systemd 运行"

#: app/companion/model.py:799
msgid ""
"A systemd service runs the engine, so VoiceMate attaches to it. To let "
"VoiceMate manage it, run `systemctl --user disable --now voicemate` in "
"WSL."
msgstr ""
"引擎由一个 systemd 服务运行，因此 VoiceMate 只连接到它。若要让 VoiceMate 管理引擎，请在 WSL 中运行 "
"`systemctl --user disable --now voicemate`。"

#: app/companion/model.py:807
msgid "Engine access denied"
msgstr "引擎拒绝访问"

#: app/companion/model.py:809
msgid ""
"The engine refused VoiceMate's access token. VoiceMate reads "
"`~/.config/voicemate/api-token` again every 30 seconds; the engine log "
"has the details."
