#: app/main.py:87
msgid "[VoiceMate] No handler available; exiting."
msgstr "[VoiceMate] Nenhum handler disponível, encerrando."

#: app/main.py:112
#, python-brace-format
msgid ""
"\n"
"[VoiceMate] Ready. Input: {input_method}"
msgstr ""
"\n"
"[VoiceMate] Pronto. Input: {input_method}"

#: app/main.py:114
#, python-brace-format
msgid "[VoiceMate] Platform: {platform} (trigger: {trigger})"
msgstr "[VoiceMate] Plataforma: {platform} (gatilho: {trigger})"

#: app/main.py:120
#, python-brace-format
msgid "[VoiceMate] Daemon listening on http://127.0.0.1:{port} (POST /trigger)."
msgstr "[VoiceMate] Daemon escutando em http://127.0.0.1:{port} (POST /trigger)."

#: app/main.py:124
msgid ""
"[VoiceMate] Register the Windows-side hotkeys with scripts/windows"
"/voicemate-hotkeys.ahk (or .ps1)."
msgstr ""
"[VoiceMate] Registre as hotkeys do lado Windows com scripts/windows"
"/voicemate-hotkeys.ahk (ou .ps1)."

#: app/main.py:127
msgid "clipboard"
msgstr "clipboard"

#: app/main.py:127
msgid "Claude (multi-turn)"
msgstr "Claude (multi-turn)"

#: app/main.py:128
#, python-brace-format
msgid "[VoiceMate] Hotkey {hotkey}: → {label}"
msgstr "[VoiceMate] Atalho {hotkey}: → {label}"

#: app/main.py:129
#, python-brace-format
msgid "[VoiceMate] Max recording: {seconds}s"
msgstr "[VoiceMate] Tempo máximo de gravação: {seconds}s"

#: app/main.py:130
msgid "[VoiceMate] Ctrl+C to exit.\n"
msgstr "[VoiceMate] Ctrl+C para sair.\n"

#: app/main.py:162
#, python-brace-format
msgid "[VoiceMate] Failed to close handler: {exc}"
msgstr "[VoiceMate] Falha ao fechar o handler: {exc}"

#: app/main.py:170
#, python-brace-format
msgid "[VoiceMate] Failed to close transcriber: {exc}"
msgstr "[VoiceMate] Falha ao fechar o transcriber: {exc}"

#: app/main.py:171
msgid ""
"\n"
"[VoiceMate] Shutting down."
msgstr ""
"\n"
"[VoiceMate] Encerrando."

#: app/cli/config_builder.py:108
msgid "[VoiceMate] ⚠ Claude flow requires input-method=keyboard. Disabling."
msgstr "[VoiceMate] ⚠ Fluxo Claude requer input-method=keyboard. Desabilitando."

#: app/cli/config_builder.py:127
msgid ""
"[VoiceMate] ⚠ --claude-no-system-prompt and --claude-system-prompt were "
"passed together; using --claude-no-system-prompt."
msgstr ""
"[VoiceMate] ⚠ --claude-no-system-prompt e --claude-system-prompt foram "
"passados juntos; usando --claude-no-system-prompt."

#: app/cli/config_builder.py:237
#, python-brace-format
msgid "[VoiceMate] Auto-seed removed: {path}"
msgstr "[VoiceMate] Auto-seed removido: {path}"

#: app/cli/config_builder.py:240
#, python-brace-format
msgid "[VoiceMate] ⚠ Failed to remove {path}: {exc}"
msgstr "[VoiceMate] ⚠ Falha ao remover {path}: {exc}"

#: app/cli/wiring.py:62
#, python-brace-format
msgid "[VoiceMate] ⚠ openai-whisper failed: {exc}"
msgstr "[VoiceMate] ⚠ Falha no openai-whisper: {exc}"

#: app/cli/wiring.py:69
msgid ""
"[VoiceMate] ⚠ whisper.cpp not found (run `make configure`); trying "
"fallback."
msgstr ""
"[VoiceMate] ⚠ whisper.cpp não encontrado (rode `make configure`); "
"tentando fallback."

#: app/cli/wiring.py:76
#, python-brace-format
msgid "[VoiceMate] ⚠ whisper.cpp failed; falling back: {exc}"
msgstr "[VoiceMate] ⚠ Falha no whisper.cpp; caindo para fallback: {exc}"

#: app/cli/wiring.py:96
#, python-brace-format
msgid "[VoiceMate] ⚠ faster-whisper (CT2-ROCm) failed on the AMD GPU: {exc}"
msgstr "[VoiceMate] ⚠ faster-whisper (CT2-ROCm) falhou na GPU AMD: {exc}"

#: app/cli/wiring.py:99
msgid "[VoiceMate]   Disabling until the next `make configure`."
msgstr "[VoiceMate]   Desabilitando até o próximo `make configure`."

#: app/cli/wiring.py:106
#, python-brace-format
msgid "[VoiceMate] ⚠ Failed to persist ct2_rocm_ok: {persist_exc}"
msgstr "[VoiceMate] ⚠ Falha ao persistir ct2_rocm_ok: {persist_exc}"

#: app/cli/wiring.py:147
msgid ""
"[VoiceMate] ⚠ No GPU backend available on AMD; using faster-whisper on "
"CPU."
msgstr ""
"[VoiceMate] ⚠ Nenhum backend GPU disponível na AMD; usando faster-whisper"
" em CPU."

#: app/cli/wiring.py:184
#, python-brace-format
msgid "[VoiceMate] ⚠ TTS disabled: engine '{engine}' packages not installed."
msgstr "[VoiceMate] ⚠ TTS desativado: pacotes do engine '{engine}' não instalados."

#: app/cli/wiring.py:188
#, python-brace-format
msgid ""
"[VoiceMate]   Install with: poetry install --extras {extra} (or run with "
"--no-tts)."
msgstr ""
"[VoiceMate]   Instale com: poetry install --extras {extra} (ou rode com "
"--no-tts)."

#: app/cli/wiring.py:198
#, python-brace-format
msgid "[VoiceMate] ⚠ TTS disabled (failed to start engine '{engine}'): {exc}"
msgstr "[VoiceMate] ⚠ TTS desativado (falha ao iniciar engine '{engine}'): {exc}"

#: app/cli/wiring.py:205
#, python-brace-format
msgid ""
"[VoiceMate]   Check `poetry install --extras {extra}`, GPU availability, "
"or run with `--no-tts`."
msgstr ""
"[VoiceMate]   Verifique `poetry install --extras {extra}`, GPU "
"disponível, ou rode com `--no-tts`."

#: app/cli/wiring.py:245
msgid "[VoiceMate] ⚠ Claude flow disabled: extra 'claude' not installed."
msgstr "[VoiceMate] ⚠ Fluxo Claude desabilitado: extra 'claude' não instalado."

#: app/cli/wiring.py:249
msgid "[VoiceMate]   Install with: poetry install --extras claude"
msgstr "[VoiceMate]   Instale com: poetry install --extras claude"

#: app/cli/wiring.py:265
#, python-brace-format
msgid "[VoiceMate] ⚠ Failed to start Claude (run `claude login`): {exc}"
msgstr "[VoiceMate] ⚠ Falha ao iniciar Claude (rode `claude login`): {exc}"

#: app/cli/wiring.py:277
#, python-brace-format
msgid "[VoiceMate] ⚠ Unknown flow ignored: {kind}"
msgstr "[VoiceMate] ⚠ Fluxo desconhecido ignorado: {kind}"

#: app/cli/wiring.py:330
#, python-brace-format
msgid ""
"[VoiceMate] ⚠ --input-method mouse is only supported on Windows "
"(trigger={trigger}); using keyboard hotkeys."
msgstr ""
"[VoiceMate] ⚠ --input-method mouse só é suportado no Windows "
"(trigger={trigger}); usando hotkeys de teclado."

#: app/companion/controller.py:570
msgid ""
"The settings file was written by a newer version of VoiceMate, so it is "
"read-only here."
msgstr ""
"O arquivo de configurações foi gravado por uma versão mais nova do "
"VoiceMate, então aqui ele fica somente para leitura."

#: app/companion/controller.py:589
msgid "Could not save the settings file."
msgstr "Não foi possível salvar o arquivo de configurações."

#: app/companion/controller.py:617
#, python-brace-format
msgid "{hotkey} is already used by another app."
msgstr "{hotkey} já está em uso por outro aplicativo."

#: app/companion/controller.py:673
msgid "Could not change the start at login setting."
msgstr "Não foi possível alterar a opção de iniciar ao entrar no sistema."

#: app/companion/cues.py:80
msgid "Recording started"
msgstr "Gravação iniciada"

#: app/companion/cues.py:81
msgid "Transcribing"
msgstr "Transcrevendo"

#: app/companion/cues.py:82
msgid "Copied"
msgstr "Copiado"

#: app/companion/cues.py:83
msgid "Claude answered"
msgstr "Claude respondeu"

#: app/companion/cues.py:84
msgid "Warning"
msgstr "Aviso"

#: app/companion/cues.py:85
msgid "Error"
msgstr "Erro"

#: app/companion/model.py:582
msgid "Engine not responding"
msgstr "O engine não responde"

#: app/companion/model.py:582
msgid "No answer from the engine. VoiceMate restarts it if this continues."
msgstr "Sem resposta do engine. O VoiceMate vai reiniciá-lo se isso continuar."

#: app/companion/model.py:584 app/companion/model.py:776
msgid "Engine is outdated"
msgstr "Engine desatualizado"

#: app/companion/model.py:584
msgid "The engine is older than this app. Update it, then use Restart engine."
msgstr ""
"O engine é mais antigo que este aplicativo. Atualize-o e depois use "
"Reiniciar engine."

#: app/companion/model.py:587 app/companion/model.py:872
msgid "No microphone"
msgstr "Sem microfone"

#: app/companion/model.py:587
msgid "Connect a microphone to record."
msgstr "Conecte um microfone para gravar."

#: app/companion/model.py:590 app/companion/model.py:859
msgid "WSL audio stopped"
msgstr "O áudio do WSL parou"

#: app/companion/model.py:590
msgid "WSL lost its audio bridge. Restarting WSL brings it back."
msgstr "O WSL perdeu a ponte de áudio. Reiniciar o WSL resolve."

#: app/companion/model.py:591 app/companion/model.py:865
msgid "Audio server is down"
msgstr "Servidor de áudio fora do ar"

#: app/companion/model.py:591
msgid "The engine cannot reach the audio server."
msgstr "O engine não consegue acessar o servidor de áudio."

#: app/companion/model.py:593 app/companion/model.py:597
#: app/companion/model.py:598 app/companion/model.py:845
msgid "Microphone unavailable"
msgstr "Microfone indisponível"

#: app/companion/model.py:594
msgid ""
"Check the privacy settings for microphone access by desktop apps, and "
"close any app that holds the microphone."
msgstr ""
"Verifique nas configurações de privacidade se aplicativos da área de "
"trabalho podem acessar o microfone e feche qualquer aplicativo que o "
"esteja usando."

#: app/companion/model.py:597
msgid "WSL cannot open the microphone. Restarting WSL fixes it."
msgstr "O WSL não consegue abrir o microfone. Reiniciar o WSL resolve."

#: app/companion/model.py:598
msgid "The engine cannot open the microphone."
msgstr "O engine não consegue abrir o microfone."

#: app/companion/model.py:603
msgid "The engine stopped unexpectedly."
msgstr "O engine parou inesperadamente."

#: app/companion/model.py:604
msgid "The engine stopped answering."
msgstr "O engine parou de responder."

#: app/companion/model.py:605
msgid "The engine took too long to start."
msgstr "O engine demorou demais para iniciar."

#: app/companion/model.py:606
msgid "Restarting WSL to recover the audio."
msgstr "Reiniciando o WSL para recuperar o áudio."

#: app/companion/model.py:607
msgid "Restart requested."
msgstr "Reinício solicitado."

#: app/companion/model.py:608
msgid "Restarting WSL."
msgstr "Reiniciando o WSL."

#: app/companion/model.py:609
msgid "The engine is restarting."
msgstr "O engine está reiniciando."

#: app/companion/model.py:616 app/companion/model.py:738
msgid "Engine folder not found"
msgstr "Pasta do engine não encontrada"

#: app/companion/model.py:616
msgid "Set the engine folder in Settings."
msgstr "Defina a pasta do engine nas Configurações."

#: app/companion/model.py:618 app/companion/model.py:619
msgid "Engine failed"
msgstr "Falha no engine"

#: app/companion/model.py:618
msgid "Restarting WSL did not help. Check the engine log, then use Restart WSL."
msgstr ""
"Reiniciar o WSL não resolveu. Veja o log do engine e depois use Reiniciar"
" WSL."

#: app/companion/model.py:619 app/companion/model.py:725
msgid ""
"The engine failed too many times. Check the engine log, then use Restart "
"engine."
msgstr ""
"O engine falhou vezes demais. Veja o log do engine e depois use Reiniciar"
" engine."

#: app/companion/model.py:625 app/companion/model.py:717
msgid "VoiceMate is stopped"
msgstr "O VoiceMate está parado"

#: app/companion/model.py:627
msgid "Starting engine..."
msgstr "Iniciando o engine..."

#: app/companion/model.py:629
#, python-brace-format
msgid "Waiting for the engine on port {port}."
msgstr "Aguardando o engine na porta {port}."

#: app/companion/model.py:631
#, python-brace-format
msgid "Restarting (attempt {attempt})"
msgstr "Reiniciando (tentativa {attempt})"

#: app/companion/model.py:635
#, python-brace-format
msgid "Listening for {hotkey}"
msgstr "Aguardando {hotkey}"

#: app/companion/model.py:635
msgid "Ready"
msgstr "Pronto"

#: app/companion/model.py:638
#, python-brace-format
msgid "Recording {elapsed}"
msgstr "Gravando {elapsed}"

#: app/companion/model.py:640
msgid "Transcribing..."
msgstr "Transcrevendo..."

#: app/companion/model.py:642
msgid "Claude is answering..."
msgstr "O Claude está respondendo..."

#: app/companion/model.py:644
#, python-brace-format
msgid "Copied: {text}"
msgstr "Copiado: {text}"

#: app/companion/model.py:650
msgid "WSL needs a restart to recover the audio. Use Restart WSL now in the menu."
msgstr ""
"O WSL precisa ser reiniciado para recuperar o áudio. Use Reiniciar WSL "
"agora no menu."

#: app/companion/model.py:687
msgid "No microphone is connected. Connect one and try again."
msgstr "Nenhum microfone conectado. Conecte um e tente de novo."

#: app/companion/model.py:691
msgid ""
"The engine could not open the microphone. Allow desktop apps to use the "
"microphone in the Windows privacy settings, and close any app that holds "
"it exclusively."
msgstr ""
"O engine não conseguiu abrir o microfone. Permita que aplicativos da área"
" de trabalho usem o microfone nas configurações de privacidade do Windows"
" e feche qualquer aplicativo que o use com exclusividade."

#: app/companion/model.py:694
msgid ""
"The engine could not open the microphone. Close any app that holds it "
"exclusively."
msgstr ""
"O engine não conseguiu abrir o microfone. Feche qualquer aplicativo que o"
" use com exclusividade."

#: app/companion/model.py:696
msgid ""
"The engine could not open the microphone: the audio server is not "
"responding."
msgstr ""
"O engine não conseguiu abrir o microfone: o servidor de áudio não "
"responde."

#: app/companion/model.py:699
msgid ""
"Windows has a microphone, but WSL cannot open it: its audio bridge is "
"stuck. Restarting WSL fixes it."
msgstr ""
"O Windows tem um microfone, mas o WSL não consegue abri-lo: a ponte de "
"áudio travou. Reiniciar o WSL resolve."

#: app/companion/model.py:701
msgid ""
"WSL cannot open the microphone. If one is connected, restarting WSL fixes"
" it."
msgstr ""
"O WSL não consegue abrir o microfone. Se houver um conectado, reiniciar o"
" WSL resolve."

#: app/companion/model.py:710
msgid "VoiceMate is starting"
msgstr "O VoiceMate está iniciando"

#: app/companion/model.py:711
msgid "The engine is still loading. Try again in a moment."
msgstr "O engine ainda está carregando. Tente de novo em instantes."

#: app/companion/model.py:718
msgid "The engine is not running. Use Restart engine in the menu."
msgstr "O engine não está rodando. Use Reiniciar engine no menu."

#: app/companion/model.py:724 app/companion/model.py:731
msgid "VoiceMate stopped retrying"
msgstr "O VoiceMate parou de tentar"

#: app/companion/model.py:732
msgid ""
"Restarting WSL did not bring the audio back. Check the engine log, then "
"use Restart WSL."
msgstr ""
"Reiniciar o WSL não trouxe o áudio de volta. Veja o log do engine e "
"depois use Reiniciar WSL."

#: app/companion/model.py:739
msgid "VoiceMate could not find the engine. Set the engine folder in Settings."
msgstr ""
"O VoiceMate não encontrou o engine. Defina a pasta do engine nas "
"Configurações."

#: app/companion/model.py:745
msgid "Could not start the engine"
msgstr "Não foi possível iniciar o engine"

#: app/companion/model.py:746
msgid ""
"Starting the engine failed. VoiceMate will try again; the engine log has "
"the details."
msgstr ""
"Falha ao iniciar o engine. O VoiceMate vai tentar de novo; o log do "
"engine tem os detalhes."

#: app/companion/model.py:752
msgid "Restarting WSL"
msgstr "Reiniciando o WSL"

#: app/companion/model.py:753
msgid ""
"WSL lost its audio, so VoiceMate is restarting it. This takes a few "
"seconds."
msgstr ""
"O WSL perdeu o áudio, então o VoiceMate está reiniciando-o. Isso leva "
"alguns segundos."

#: app/companion/model.py:759 app/companion/model.py:766
msgid "WSL needs a restart"
msgstr "O WSL precisa ser reiniciado"

#: app/companion/model.py:760
msgid "WSL lost its audio. Choose Restart WSL now in the VoiceMate menu."
msgstr "O WSL perdeu o áudio. Escolha Reiniciar WSL agora no menu do VoiceMate."

#: app/companion/model.py:768
#, python-brace-format
msgid ""
"WSL lost its audio, but restarting it also stops {distros}. Choose "
"Restart WSL now in the VoiceMate menu when convenient."
msgstr ""
"O WSL perdeu o áudio, mas reiniciá-lo também para {distros}. Escolha "
"Reiniciar WSL agora no menu do VoiceMate quando for conveniente."

#: app/companion/model.py:777
msgid ""
"The engine is older than this app. Update it, then use Restart engine in "
"the menu."
msgstr ""
"O engine é mais antigo que este aplicativo. Atualize-o e depois use "
"Reiniciar engine no menu."

#: app/companion/model.py:783
msgid "Engine run by systemd"
msgstr "Engine executado pelo systemd"

#: app/companion/model.py:785
msgid ""
"A systemd service runs the engine, so VoiceMate attaches to it. To let "
"VoiceMate manage it, run `systemctl --user disable --now voicemate` in "
"WSL."
msgstr ""
"Um serviço do systemd executa o engine, então o VoiceMate se conecta a "
"ele. Para o VoiceMate gerenciá-lo, rode `systemctl --user disable --now "
"voicemate` no WSL."

#: app/companion/model.py:793
msgid "Engine access denied"
msgstr "Acesso ao engine negado"

#: app/companion/model.py:795
msgid ""
"The engine refused VoiceMate's access token. VoiceMate reads "
"`~/.config/voicemate/api-token` again every 30 seconds; the engine log "
"has the details."
msgstr ""
"O engine recusou o token de acesso do VoiceMate. O VoiceMate lê "
"`~/.config/voicemate/api-token` de novo a cada 30 segundos; o log do "
"engine tem os detalhes."

#: app/companion/model.py:803
msgid "Settings reset"
msgstr "Configurações redefinidas"

#: app/companion/model.py:805
#, python-brace-format
msgid ""
"The settings file could not be read, so VoiceMate started with the "
"default settings. The old file was kept as {path}."
msgstr ""
"Não foi possível ler o arquivo de configurações, então o VoiceMate "
"iniciou com as configurações padrão. O arquivo antigo foi guardado como "
"{path}."

#: app/companion/model.py:813
msgid "Engine unreachable"
msgstr "Engine inacessível"

#: app/companion/model.py:814
msgid "The engine did not answer. VoiceMate keeps trying to reconnect."
msgstr "O engine não respondeu. O VoiceMate continua tentando reconectar."

#: app/companion/model.py:820
msgid "Engine busy"
msgstr "Engine ocupado"

#: app/companion/model.py:821
msgid "The engine did not answer in time. It may still act on this key press."
msgstr "O engine não respondeu a tempo. Ele ainda pode reagir a este atalho."

#: app/companion/model.py:827
msgid "Request rejected"
msgstr "Pedido recusado"

#: app/companion/model.py:828
#, python-brace-format
msgid "The engine rejected the request (HTTP {status})."
msgstr "O engine recusou o pedido (HTTP {status})."

#: app/companion/model.py:832
msgid "Engine error"
msgstr "Erro no engine"

#: app/companion/model.py:832
msgid "The engine reported an internal error. See the engine log."
msgstr "O engine informou um erro interno. Veja o log do engine."

#: app/companion/model.py:834
msgid "Nothing transcribed"
msgstr "Nada transcrito"

#: app/companion/model.py:834
msgid "No speech was detected in the recording."
msgstr "Nenhuma fala foi detectada na gravação."

#: app/companion/model.py:836
msgid "Nothing recorded"
msgstr "Nada gravado"

#: app/companion/model.py:836
msgid "The recording captured no audio."
msgstr "A gravação não capturou áudio."

#: app/companion/model.py:840
msgid "Slow transcription"
msgstr "Transcrição lenta"

#: app/companion/model.py:841
msgid ""
"Transcription is running slower than usual. The engine log has the "
"details."
msgstr ""
"A transcrição está mais lenta que o normal. O log do engine tem os "
"detalhes."

#: app/companion/model.py:849
msgid "Transcription failed"
msgstr "Falha na transcrição"

#: app/companion/model.py:850
msgid "The engine could not transcribe the recording. See the engine log."
msgstr "O engine não conseguiu transcrever a gravação. Veja o log do engine."

#: app/companion/model.py:854
msgid "Claude did not answer"
msgstr "O Claude não respondeu"

#: app/companion/model.py:854
msgid "The request to Claude failed. See the engine log."
msgstr "O pedido ao Claude falhou. Veja o log do engine."

#: app/companion/model.py:860
msgid "The engine cannot reach the WSL audio server, so recording will fail."
msgstr ""
"O engine não consegue acessar o servidor de áudio do WSL, então a "
"gravação vai falhar."

#: app/companion/model.py:866
msgid "The engine cannot reach the audio server, so recording will fail."
msgstr ""
"O engine não consegue acessar o servidor de áudio, então a gravação vai "
"falhar."

#: app/companion/model.py:873
msgid "No microphone is connected. Recording will fail until you connect one."
msgstr "Nenhum microfone conectado. A gravação vai falhar até você conectar um."

#: app/companion/model.py:878
msgid ""
"A transcription was not copied to the clipboard. Open VoiceMate to copy "
"it."
msgstr ""
"Uma transcrição não foi copiada para a área de transferência. Abra o "
"VoiceMate para copiá-la."

#: app/companion/model.py:880
#, python-brace-format
msgid ""
"{count} transcriptions were not copied to the clipboard. Open VoiceMate "
"to copy them."
msgstr ""
"{count} transcrições não foram copiadas para a área de transferência. "
"Abra o VoiceMate para copiá-las."

#: app/companion/model.py:883 app/companion/model.py:885
msgid "Not copied"
msgstr "Não copiado"

#: app/companion/model.py:885
msgid "The text could not be copied to the clipboard. Try again."
msgstr ""
"Não foi possível copiar o texto para a área de transferência. Tente de "
"novo."

#: app/companion/model.py:889
msgid "Hotkey unavailable"
msgstr "Atalho indisponível"

#: app/companion/model.py:891
#, python-brace-format
msgid ""
"Already used by another app: {hotkeys}. If the old VoiceMate hotkeys "
"script is running, close it and remove it from shell:startup, or choose "
"other hotkeys in Settings."
msgstr ""
"Já em uso por outro aplicativo: {hotkeys}. Se o script antigo de atalhos "
"do VoiceMate estiver rodando, feche-o e remova-o de shell:startup, ou "
"escolha outros atalhos nas Configurações."

#: app/companion/settings_store.py:87
msgid "Language"
msgstr "Idioma"

#: app/companion/settings_store.py:88
